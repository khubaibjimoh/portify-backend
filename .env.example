# =======================
# SERVER CONFIGURATION
# =======================
PORT=5000                   # The port your Express server will run on

# =======================
# DATABASE CONFIGURATION
# =======================
# MongoDB connection string (MongoDB Atlas recommended)
# Example format:
# mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/DATABASE_NAME
MONGO_URI=your_mongodb_connection_string_here

# =======================
# JWT AUTHENTICATION
# =======================
# Secret key used to sign JSON Web Tokens
JWT_SECRET=your_secret_key_here
# Token expiry time: '1d' = 1 day, '7d' = 7 days, '1h' = 1 hour
JWT_EXPIRES_IN=1d

# =======================
# CLOUDINARY / FILE UPLOADS (Optional)
# =======================
# Only needed if you plan to store images (profile pics, project images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =======================
# EMAIL SERVICE (Optional)
# =======================
# For sending notifications, confirmations, etc.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=

# =======================
# OTHER ENVIRONMENT VARIABLES
# =======================
# Add any future variables here to keep .env.example updated